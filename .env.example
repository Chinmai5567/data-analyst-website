# Local admin bootstrap. Change these before starting the server.
ANALYTICS_HUB_ADMIN_USERNAME=hubadmin
ANALYTICS_HUB_ADMIN_PASSWORD=replace_with_a_random_password_at_least_16_characters
ANALYTICS_HUB_HOST=127.0.0.1
# Use an absolute persistent storage path on a hosted service, such as /var/data.
ANALYTICS_HUB_DATA_DIR=.
# Set true only when HTTPS is enabled at the public host/proxy. Set the exact
# public origins, comma-separated, when deploying.
ANALYTICS_HUB_COOKIE_SECURE=false
ANALYTICS_HUB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
